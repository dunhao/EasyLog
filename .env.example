# ============================================================================
# EasyLog 项目根级环境变量
# 本文件仅用于本地开发的快捷参考；各子模块有独立的 .env.example：
#   - services/admin/.env.example      (后端 Laravel 应用)
#   - frontend/.env.example            (前端 Vite 应用)
#   - deploy/compose/.env.example      (Docker Compose 编排)
# 复制对应目录的 .env.example 为 .env 后按需修改即可。
# ============================================================================

# 后端 API 入口（业务方 SDK 推送日志使用）
EASYLOG_INGEST_ENDPOINT=http://localhost:9514

# 控制台 API 入口（前端调用）
EASYLOG_ADMIN_ENDPOINT=http://localhost:9515

# 前端开发服务器
EASYLOG_FRONTEND_URL=http://localhost:9516

# 开发账号（仅本地 seed 后可用，生产请通过控制台创建）
EASYLOG_DEV_EMAIL=admin@easylog.local
EASYLOG_DEV_PASSWORD=easylog123

# 存储后端选择：elasticsearch | openobserve | quickwit | sqlite（lite 档）
EASYLOG_STORAGE_DRIVER=elasticsearch

# 内部消息总线：direct（lite 直写，无 Kafka）| rdkafka | log | inmemory
EASYLOG_MQ_BUS_DRIVER=rdkafka

# 内部 Kafka 消息总线（core/full 档）
EASYLOG_KAFKA_BROKERS=localhost:29092

# 外部 MQ 测试（compose 启动 RabbitMQ 后可用）
EASYLOG_RABBIT_HOST=localhost:5672
EASYLOG_RABBIT_USER=easylog
EASYLOG_RABBIT_PASSWORD=easylog

# Elasticsearch
EASYLOG_ES_HOSTS=http://localhost:9200

# MySQL（元数据库）
EASYLOG_MYSQL_HOST=localhost
EASYLOG_MYSQL_PORT=3306
EASYLOG_MYSQL_DATABASE=easylog
EASYLOG_MYSQL_USER=easylog
EASYLOG_MYSQL_PASSWORD=easylog

# Redis
EASYLOG_REDIS_HOST=localhost
EASYLOG_REDIS_PORT=6379
