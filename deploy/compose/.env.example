# EasyLog Docker Compose 环境变量
# 复制为 .env 后按需修改（start.sh 首次启动会自动生成 .env 并补随机 APP_KEY）

# ============================================================================
# 启动档位（三档按需启动，互斥；也可用 ./start.sh lite|core|full 切换）
#   lite（默认）= app + frontend，SQLite 全自包含，零外部依赖
#   core        = redis/es/zk/kafka + 5 应用角色 + frontend（需宿主机 MySQL）
#   full        = core + rabbitmq + worker（外部 MQ 消费 + 命令行告警巡检）
# ============================================================================
COMPOSE_PROFILES=lite

# ============================================================================
# EasyLog 应用凭据（替代原先硬编码在 docker-compose.yml 中的密钥）
# ============================================================================
# Laravel 应用密钥（base64:32 字节；.env 中缺失时 start.sh 自动生成）
#EASYLOG_APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=

# ---- 以下仅 core/full 档需要（lite 档用 SQLite，无需 MySQL）----
# 宿主机 MySQL（compose 不启动 mysql 容器，直连宿主机）
EASYLOG_DB_HOST=192.168.1.100
EASYLOG_DB_USERNAME=root
# 宿主机 MySQL root 密码（core/full 档启动必填，无法自动生成）
#EASYLOG_DB_PASSWORD=changeme

# ---- 以下仅 lite 档需要 ----
# lite 档 Octane worker 数（默认 2；更小内存机器可降为 1）
#LITE_OCTANE_WORKERS=2
# lite 档告警巡检（默认 0 关闭；设 1 时由 app 容器附带拉起告警评估/通知循环）
#EASYLOG_ALERT_LOOPS=0

# ============================================================================
# 前端
# ============================================================================
FRONTEND_PORT=9516
# /api 反代上游：lite 档 app:9515（默认），core/full 档 query:9515
# （start.sh 会按档位自动设置，仅裸 docker compose up 时读这里）
#API_UPSTREAM=app:9515

# ============================================================================
# 告警邮件渠道（full 档 worker / 开启巡检的容器投递告警邮件时使用）
# ============================================================================
# log = 邮件内容写入日志（默认，不真发）；smtp = 真实发送
MAIL_MAILER=log
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
MAIL_FROM_ADDRESS=easylog@localhost

# ============================================================================
# Redis（core/full 档）
# ============================================================================
REDIS_PORT=6379

# ============================================================================
# Elasticsearch（core/full 档）
# ============================================================================
ES_HTTP_PORT=9200
ES_TRANSPORT_PORT=9300

# ============================================================================
# Kafka（core/full 档）
# ============================================================================
KAFKA_PORT=9092

# ============================================================================
# RabbitMQ（full 档，外部 MQ 模拟）
# ============================================================================
RABBIT_USER=easylog
RABBIT_PASS=easylog
RABBIT_PORT=5672
RABBIT_MGMT_PORT=15672
