APP_NAME=EasyLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN
APP_TIMEZONE=Asia/Shanghai

# ---------- Logging ----------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- Database (元数据) ----------
# 本地默认 SQLite，生产可切回 mysql
DB_CONNECTION=sqlite
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=easylog
DB_USERNAME=easylog
DB_PASSWORD=secret

# ---------- Redis (缓存/限流/WebSocket) ----------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------- Ingestion 接入网关 ----------
INGESTION_PORT=9514
INGEST_BATCH_SIZE=1000
INGEST_FLUSH_SECONDS=5
INGEST_RATE_LIMIT=1000
INGEST_DAILY_QUOTA_GB=50
INGEST_QUOTA_ACTION=reject

# ---------- Storage 后端 ----------
# elasticsearch | openobserve | quickwit | sqlite（lite 档，零依赖单文件）
STORAGE_DRIVER=elasticsearch

# Elasticsearch
ES_HOSTS=http://elasticsearch:9200
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_SSL_VERIFY=false
ES_INDEX_PREFIX=easylog-
ES_BULK_SIZE=1000
ES_REFRESH=false

# OpenObserve (备选)
OO_URL=http://openobserve:5080
OO_ORG=easylog
OO_STREAM=default
OO_API_KEY=
OO_BULK_SIZE=1000

# Quickwit (备选)
QW_URL=http://quickwit:7280
QW_INDEX=easylog
QW_BULK_SIZE=1000

# SQLite（lite 档：日志存本地单文件，配合 MQ_BUS_DRIVER=direct 裸跑全自包含）
SQLITE_LOG_PATH=database/easylog-logs.sqlite

# ---------- 内部消息总线 ----------
# driver: direct（lite 单机直写，无 Kafka）| rdkafka（生产，需扩展）| log（开发，写日志）| inmemory（测试）
MQ_BUS_DRIVER=log
KAFKA_BROKERS=kafka:9092
KAFKA_SASL_ENABLED=false
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USER=
KAFKA_SASL_PASSWORD=
KAFKA_TLS=false
KAFKA_CA_CERT=
KAFKA_TOPIC_PREFIX=easylog.ingest.
KAFKA_RETENTION_HOURS=24
KAFKA_PARTITION_COUNT=6

# ---------- 外部 MQ 消费者开关 ----------
CONSUMER_KAFKA_ENABLED=true
CONSUMER_KAFKA_WORKERS=2
CONSUMER_KAFKA_POLL_MS=5000

CONSUMER_RABBITMQ_ENABLED=true
CONSUMER_RABBITMQ_WORKERS=2
CONSUMER_RABBITMQ_PREFETCH=1000

CONSUMER_REDIS_ENABLED=true
CONSUMER_REDIS_WORKERS=2
CONSUMER_REDIS_BLOCK_MS=5000
CONSUMER_REDIS_BATCH=1000

CONSUMER_ACTIVEMQ_ENABLED=true
CONSUMER_ACTIVEMQ_WORKERS=1

# ---------- Octane / Swoole ----------
OCTANE_SERVER=swoole
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000
OCTANE_WORKERS=4
OCTANE_TASK_WORKERS=8
OCTANE_MAX_REQUESTS=10000

# ---------- Sanctum ----------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080
SESSION_DRIVER=redis
SESSION_DOMAIN=localhost
