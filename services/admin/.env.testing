APP_NAME=EasyLog
APP_ENV=testing
APP_KEY=base64:kpTm4y3LZx9QYr1t+8sJf3wVqg7z2K5h1rY0u6mCxRQ=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=zh_CN
APP_TIMEZONE=Asia/Shanghai

LOG_CHANNEL=stack
LOG_STACK=errorlog
LOG_LEVEL=error

# ---------- Database (元数据) - 内存 SQLite ----------
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# ---------- Redis ----------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=123456
REDIS_PORT=6379

# ---------- Storage ----------
STORAGE_DRIVER=elasticsearch
ES_HOSTS=http://127.0.0.1:9200
ES_INDEX_PREFIX=easylog-test-

# ---------- MessageQueue - 测试用 inmemory ----------
MQ_BUS_DRIVER=inmemory
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC_PREFIX=easylog.ingest.

# ---------- 消费者全关 ----------
CONSUMER_KAFKA_ENABLED=false
CONSUMER_RABBITMQ_ENABLED=false
CONSUMER_REDIS_ENABLED=false
CONSUMER_ACTIVEMQ_ENABLED=false

# ---------- Octane ----------
OCTANE_SERVER=swoole
OCTANE_PORT=8765

# ---------- Sanctum ----------
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DRIVER=array
SESSION_DOMAIN=localhost
