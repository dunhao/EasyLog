{
    "name": "easylog/easylog",
    "description": "EasyLog - Open source multi-tenant SaaS log service platform",
    "type": "project",
    "license": "Apache-2.0",
    "keywords": ["log", "logging", "saas", "multi-tenant", "observability", "php", "laravel"],
    "homepage": "https://github.com/easylog/easylog",
    "authors": [
        {
            "name": "EasyLog Contributors"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "EasyLog\\": "services/admin/app/",
            "EasyLog\\SDK\\": "sdk/php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "services/admin/tests/"
        }
    },
    "scripts": {
        "test": [
            "services/admin/vendor/bin/phpunit"
        ],
        "lint": [
            "vendor/bin/pint --test services/admin/app sdk/php/src"
        ],
        "fix": [
            "vendor/bin/pint services/admin/app sdk/php/src"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
